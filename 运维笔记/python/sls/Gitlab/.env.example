# 阿里云日志服务（SLS）
SLS_ENDPOINT=cn-zhangjiakou.log.aliyuncs.com
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_PROJECT=k8s-log-c0a1e7630d4ee4a5e82355043999641ae
SLS_LOGSTORE=openresty-szc

# 报表对外访问前缀，接口返回的链接会拼在后面
# 例：http://127.0.0.1:8080/20260916-144530.html?token=随机值
REPORT_URL=http://127.0.0.1:8080

# 调用 /api/generate 的口令（请求头 X-Api-Token）。未设置时回退到 REPORT_TOKEN
REPORT_API_TOKEN="replace-me-api"

# 兼容旧配置：未设置 REPORT_API_TOKEN 时，用它保护生成接口
# REPORT_TOKEN="replace-me"
