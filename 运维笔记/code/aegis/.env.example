AEGIS_SEED_DEMO=true
# 本地运行建议使用 ./data；Docker Compose 会覆盖为 /var/lib/aegis
AEGIS_DATA_DIR=./data
AEGIS_PORT=8080
# 留空使用本地 SQLite；生产环境配置 PostgreSQL DSN，并通过 Secret Manager 注入。
AEGIS_DATABASE_URL=
AEGIS_ADMIN_TOKEN=change-this-in-a-secret-manager
# Web console login. The bootstrap user is created only when it does not exist.
AEGIS_AUTH_USERNAME=admin
AEGIS_AUTH_PASSWORD=change-this-password
AEGIS_SESSION_TTL_SECONDS=28800
# Set true when the service is behind HTTPS; keep false for local http:// use.
AEGIS_SESSION_COOKIE_SECURE=false
AEGIS_EXECUTOR_MODE=dry-run
AEGIS_SSH_TIMEOUT=15
# 本地 JSONL 只用于 staging/hash-chain 归档，不等于 WORM；生产应接对象存储 Object Lock。
AEGIS_AUDIT_ARCHIVE_PATH=
AEGIS_AUDIT_ARCHIVE_REQUIRED=false
# Production WORM archive: S3-compatible bucket must have versioning/Object Lock enabled.
AEGIS_AUDIT_ARCHIVE_S3_BUCKET=
AEGIS_AUDIT_ARCHIVE_S3_PREFIX=aegis-audit
AEGIS_AUDIT_ARCHIVE_S3_RETENTION_DAYS=365
AEGIS_AUDIT_ARCHIVE_S3_ENDPOINT_URL=
# 命令白名单；为空时使用内置只读诊断命令集合。生产环境按需显式收敛。
AEGIS_ALLOWED_COMMANDS=uname,id,whoami,hostname,uptime,pwd,ls,df,free,date
# SSH mode requires secret:// references resolved from this mounted directory.
# Leave empty to fail closed; do not put private-key contents in .env or API bodies.
AEGIS_SSH_CREDENTIAL_DIR=
# Optional alert webhooks. Keep them in a secret manager in production.
AEGIS_FEISHU_WEBHOOK=
AEGIS_DINGTALK_WEBHOOK=
AEGIS_WECOM_WEBHOOK=
