PROMETHEUS_URL=http://prometheus.monitoring.svc:9090
# PROMETHEUS_TOKEN=仅在 Prometheus 网关要求 Bearer Token 时设置
PROMETHEUS_TIMEOUT_SECONDS=5
K8S_SERVICE_NAMESPACE=prod
# 留空表示查询所有服务；也可由请求参数 ?service=order-api 筛选
K8S_SERVICE_NAMES=order-api,payment-api
DISK_MOUNTPOINTS=/
LOAD_PER_CPU_WARN=1.0
LOAD_PER_CPU_CRITICAL=2.0
MEMORY_WARN_PERCENT=80
MEMORY_CRITICAL_PERCENT=90
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90
