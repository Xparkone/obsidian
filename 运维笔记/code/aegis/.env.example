AEGIS_SEED_DEMO=true
# 本地运行建议使用 ./data；Docker Compose 会覆盖为 /var/lib/aegis
AEGIS_DATA_DIR=./data
AEGIS_PORT=8080
AEGIS_ADMIN_TOKEN=change-this-in-a-secret-manager
AEGIS_EXECUTOR_MODE=dry-run
AEGIS_SSH_TIMEOUT=15
# Optional alert webhooks. Keep them in a secret manager in production.
AEGIS_FEISHU_WEBHOOK=
AEGIS_DINGTALK_WEBHOOK=
AEGIS_WECOM_WEBHOOK=
