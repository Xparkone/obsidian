  "cards": [
    {
      "dot": "cyan",
      "title": "核心思路",
      "items": [
        "巡检是周期快照，不是 Alertmanager 的替代品",
        "只读 Prometheus HTTP API，状态沿用四态枚举"
      ]
    },
    {
      "dot": "emerald",
      "title": "复用现有工程",
      "items": [
        "在 fastapi-prometheus-status 上扩展，沿用 5 秒超时客户端",
        "硬编码检查抽成 YAML；API 回看同一份结果仓储"
      ]
    },
    {
      "dot": "amber",
      "title": "落地约束",
      "items": [
        "MVP 用单进程 APScheduler + SQLite，避免多副本抢跑",
        "缺指标记 unknown；GitLab 指标名需现场核对"
      ]
    }
